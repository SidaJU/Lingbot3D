# Keep only the dataset directory skeleton and manifests in Git. Datasets,
# sidecars and checkpoints stay local to each machine. Models belong in the
# repository-root models/ directory, third-party code in third_party/, and
# training runs in runs/.
*
!.gitignore
!README.md
!datasets/
!datasets/.gitkeep
!lerobot/
!lerobot/.gitkeep
!robotwin2_raw/
!robotwin2_raw/.gitkeep
!camera_sidecars/
!camera_sidecars/.gitkeep
!depth_sidecars/
!depth_sidecars/.gitkeep
!training_data/
!training_data/robotwin.txt
!training_data/robotwin_a10080.txt
