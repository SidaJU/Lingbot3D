# Keep only the directory skeleton and manifests in Git. Models, datasets,
# sidecars, checkpoints and debug images stay local to each machine.
*
!.gitignore
!README.md
!models/
!models/.gitkeep
!models/lpips_cache/
!models/lpips_cache/.gitkeep
!datasets/
!datasets/.gitkeep
!lerobot/
!lerobot/.gitkeep
!robotwin2_raw/
!robotwin2_raw/.gitkeep
!camera_sidecars/
!camera_sidecars/.gitkeep
!depth_sidecars/
!depth_sidecars/.gitkeep
!training_data/
!training_data/robotwin.txt
!training_data/robotwin_a10080.txt
!outputs/
!outputs/.gitkeep
